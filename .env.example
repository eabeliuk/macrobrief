# ── Required ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/macrobrief"
# openssl rand -base64 32
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Sign-in (register at least one, or nobody can sign in) ────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_RESEND_KEY=""
EMAIL_FROM="MacroBrief <brief@macrobrief.com>"

# ── The model: source discovery + brief composition ────────────────────
# Unset: query feeds (Google/Bing News) still work; publisher-feed suggestions
# and composed briefs are skipped with a logged reason.
ANTHROPIC_API_KEY=""

# ── Audio briefs (Pro+) ───────────────────────────────────────────────
# Google Cloud Text-to-Speech (Neural2) via ADC — no key. Locally: gcloud auth application-default login.
# Private GCS bucket for the mp3s (created by ./deploy.sh --setup).
AUDIO_BUCKET=""
# Locally, bill the API to this project (Cloud Run does this by itself).
GOOGLE_CLOUD_QUOTA_PROJECT="macrobrief1"
# Set to 1 to record AUDIO deliveries as failed instead of calling the API (e.g. a machine without ADC).
TTS_DISABLED=""

# ── WhatsApp (Pro+) ───────────────────────────────────────────────────
# Unset: WHATSAPP deliveries are recorded FAILED with "not configured".
# Provider is Telnyx when its credentials exist, else Twilio; force with WHATSAPP_PROVIDER=telnyx|twilio.
TELNYX_API_KEY=""
# Your WhatsApp-enabled Telnyx number, E.164.
TELNYX_WHATSAPP_FROM=""
# Approved Meta template NAME with variables {{1}} title, {{2}} digest, {{3}} link — required outside the 24 h window.
TELNYX_WA_TEMPLATE=""
TELNYX_WA_TEMPLATE_LANG="en"
# Meta stores a template under an exact language code; the code template is often en_US while the brief one is en.
TELNYX_WA_AUTH_TEMPLATE="verification_code"
TELNYX_WA_AUTH_TEMPLATE_LANG="en_US"
# Approved Meta AUTHENTICATION template NAME (copy-code button) for channel verification codes; unset = reader must message the sender first.
TELNYX_WA_AUTH_TEMPLATE=""
# Twilio alternative (superMila's account): sender e.g. whatsapp:+14155238886 (sandbox); template = Content SID (HX…).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WA_TEMPLATE_SID=""
TWILIO_WA_AUTH_TEMPLATE_SID=""

# ── Billing ───────────────────────────────────────────────────────────
# Unset: the billing page says "not configured"; everyone stays on FREE.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# From `npx tsx scripts/stripe-setup.ts`
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_MAX=""

# ── Scheduled jobs ────────────────────────────────────────────────────
# Cloud Scheduler calls GET /api/cron with `Authorization: Bearer $CRON_SECRET`.
# openssl rand -hex 32
CRON_SECRET=""

# Comma-separated emails that become super-admins on first sign-in.
SUPER_ADMINS=""
# Private beta: while set, ONLY these emails can sign in or sign up. Unset = open.
ALLOWED_EMAILS=""
